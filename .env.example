VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para el servidor MCP (mcp/server.mjs): tu login de Thread.
# Ponelos en .env.local (no se commitea).
THREAD_EMAIL=
THREAD_PASSWORD=

# ── Solo servidor (Vercel → Settings → Environment Variables). NUNCA con prefijo VITE_. ──
# IA (extraer tareas / analizar proyecto)
GROQ_API_KEY=
# Correo (Resend). Sin RESEND_API_KEY los correos se simulan en el log.
RESEND_API_KEY=
RESEND_FROM="Thread <avisos@tu-dominio.com>"
# Cron diario /api/digest y webhook /api/github escriben sin usuario → service role.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel lo manda como "Authorization: Bearer $CRON_SECRET" al invocar el cron.
CRON_SECRET=
# Mismo secreto que en GitHub → Settings → Webhooks.
GITHUB_WEBHOOK_SECRET=
# URL pública de la app para los links de los correos del cron (opcional).
APP_URL=https://tu-app.vercel.app
